# Web3Forms — https://web3forms.com (exposed to browser for form submit)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Canonical site URL for SEO / Open Graph (production). Falls back to window origin in dev.
# Example: https://ligayatech.com
NEXT_PUBLIC_SITE_URL=

# Optional: full URL to a 1200×630 social share image (PNG/JPG). Defaults to /og.svg if unset.
# NEXT_PUBLIC_OG_IMAGE_URL=https://ligayatech.com/og-image.png

# Optional: Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Loads only after cookie banner Accept.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Calendly / Cal.com — full embed URL for iframe (optional)
# Example: https://calendly.com/your-handle/30min
NEXT_PUBLIC_BOOKING_EMBED_URL=

# Optional: full URL to chat API (default same-origin /api/chat)
# NEXT_PUBLIC_ASSISTANT_API_URL=https://your-domain.com/api/chat

# ── Help chat — real LLMs, SERVER-SIDE ONLY (never use NEXT_PUBLIC_ for API keys).
#
# CHAT_PROVIDER=openai | anthropic | gemini | (omit for auto)
#
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
#
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
#
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
